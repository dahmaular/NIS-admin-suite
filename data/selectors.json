    "type": "text",
    "selector": "div[class*='statisticsNumbers'] > div:nth-of-type(2) span[class*='statisticNumber']"
  },
  "stats.value3": {
    "type": "text",
    "selector": "div[class*='statisticsNumbers'] > div:nth-of-type(3) span[class*='statisticNumber']"
