# Build-time config for the admin dashboard (cPanel deployment).
# Copy to admin/.env.production and fill in, then run `npm run build`.
# Vite inlines these values into the bundle — they are PUBLIC. Never put the
# admin password, JWT secret or any Cloudinary/Mongo credential in here.

# Origin of the API deployed on Vercel — no trailing slash, no /api suffix.
VITE_API_BASE=https://nis-admin-suite.vercel.app

# Origin of the real public site, used by the preview iframe, the element
# picker and the "view site" links — no trailing slash.
VITE_SITE_ORIGIN=https://nisng.com
