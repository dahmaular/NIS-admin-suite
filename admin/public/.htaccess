# NIS Admin dashboard — Apache config for cPanel.
# Lives in admin/public/ so Vite copies it into admin/dist/ on every build;
# upload it alongside index.html into the document root on cPanel.

# --- Force HTTPS -----------------------------------------------------------
# The admin stores its JWT in localStorage and talks to the API cross-origin;
# it must never be served over plain HTTP.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- SPA fallback ----------------------------------------------------------
# The dashboard is a single index.html (tabs are component state, not routes),
# but this keeps deep links / refreshes from 404-ing if routing is added later.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# --- Caching ---------------------------------------------------------------
# Vite fingerprints everything in /assets, so those are immutable. index.html
# must never be cached or users keep booting an old build against a new API.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # --- Security headers ----------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
