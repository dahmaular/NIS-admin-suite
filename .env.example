# --- Auth (change these!) ---
ADMIN_PASSWORD=changeme
JWT_SECRET=a-long-random-secret

# --- Server ---
PORT=5175

# --- MongoDB (documents: content, selectors, media index) ---
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
# Leave unset to fall back to ./data/*.json files (local dev only).
MONGODB_URI=
MONGODB_DB=nis-admin

# --- Cloudinary (image/media storage) ---
# Copy from your Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave unset to fall back to the local ./uploads folder (local dev only).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=nis-admin

# --- Deploying to Vercel ---
# MONGODB_URI and CLOUDINARY_URL above are REQUIRED on Vercel (no persistent
# disk to fall back to) — set all vars in this file as Vercel project
# Environment Variables (Settings -> Environment Variables), not in a
# committed .env. See README.md "Deploying to Vercel" for the full guide.
#
# VITE_SITE_ORIGIN is used by the admin app at BUILD time (set it in Vercel
# too) so links, the live-preview iframe, and the element picker point at the
# real production site, which is a separate deployment from this admin app.
VITE_SITE_ORIGIN=https://norwegianinternationalschools.com
