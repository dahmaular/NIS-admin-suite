# --- Auth (change these!) ---
ADMIN_PASSWORD=changeme
JWT_SECRET=a-long-random-secret

# --- Server ---
PORT=5175

# --- MongoDB (documents: content, selectors, media index) ---
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
# Leave unset to fall back to ./data/*.json files (local dev only).
MONGODB_URI=
MONGODB_DB=nis-admin

# --- Cloudinary (image/media storage) ---
# Copy from your Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave unset to fall back to the local ./uploads folder (local dev only).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=nis-admin

# --- Deploying ---
# This file configures the API only. MONGODB_URI and CLOUDINARY_URL above are
# REQUIRED on Vercel (no persistent disk to fall back to) — set them as Vercel
# project Environment Variables (Settings -> Environment Variables), not in a
# committed .env.
#
# The admin dashboard is a SEPARATE deployment (static files on cPanel) with
# its own BUILD-time config in admin/.env.production — VITE_API_BASE (this
# API's origin) and VITE_SITE_ORIGIN (the real public site). Those two do NOT
# belong here or in Vercel's environment; see admin/.env.production.example.
#
# Full walkthrough: DEPLOYMENT.md
